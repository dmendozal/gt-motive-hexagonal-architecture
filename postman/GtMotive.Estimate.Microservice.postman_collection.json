{
  "info": {
    "_postman_id": "f4d1d0d9-4df5-4b14-8b4f-59f2e8ec4f4b",
    "name": "GtMotive Estimate Microservice",
    "description": "Collection for the fleet rental microservice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Create Vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vin\": \"VIN-001\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Corolla\",\n  \"manufacturingDate\": \"2023-01-10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vehicles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicles"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.environment.set(\"vehicleId\", response.vehicleId);",
                  "pm.environment.set(\"vin\", response.vin);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Available Vehicles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vehicles/available",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vehicles",
                "available"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Rentals",
      "item": [
        {
          "name": "Rent Vehicle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"personDocumentId\": \"12345678A\",\n  \"personName\": \"Jane Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rentals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rentals"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.environment.set(\"rentalId\", response.rentalId);",
                  "pm.environment.set(\"vehicleId\", response.vehicleId);",
                  "pm.environment.set(\"personDocumentId\", response.personDocumentId);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Return Rental",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"personDocumentId\": \"{{personDocumentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rentals/{{rentalId}}/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rentals",
                "{{rentalId}}",
                "return"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
